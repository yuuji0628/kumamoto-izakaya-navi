{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kumamoto-izakaya-navi",
  "main": "worker.js",
  "compatibility_date": "2026-08-17",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/db-status"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "KIN_VERSION": "1.19",
    "GITHUB_OWNER": "yuuji0628",
    "GITHUB_REPO": "kumamoto-izakaya-navi",
    "GITHUB_BRANCH": "main",
    "CLOUDFLARE_WORKER_NAME": "kumamoto-izakaya-navi"
  },
  "triggers": {
    "crons": [
      "10 18 * * *",
      "10 2 * * *",
      "10 10 * * *"
    ]
  }
}
