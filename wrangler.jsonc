{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kumamoto-izakaya-navi",
  "main": "worker.js",
  "compatibility_date": "2026-08-17",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/db-status"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "KIN_VERSION": "1.24",
    "GITHUB_OWNER": "yuuji0628",
    "GITHUB_REPO": "kumamoto-izakaya-navi",
    "GITHUB_BRANCH": "main",
    "CLOUDFLARE_WORKER_NAME": "kumamoto-izakaya-navi",
    "KIN_SCHEDULE_UPDATED_AT": "2026-08-19T13:57:51.544Z"
  },
  "triggers": {
    "crons": [
      "0 20 * * *",
      "0 10 * * *",
      "0 14 * * *"
    ]
  }
}
